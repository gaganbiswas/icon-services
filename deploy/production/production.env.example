# Production environment for deploy/production/compose.yml (Phase 12).
# Copy to /etc/icon/production.env on the server: chown root:root, chmod 600.
# NEVER commit the real file. Generate secrets with openssl rand (see docs/production/README.md).
# Compose-level values (POSTGRES_PASSWORD, domains, IMAGE_TAG) are passed via the shell or an
# adjacent .env next to compose.yml with the same protection.

# ---- Core
NODE_ENV=production
LOG_LEVEL=log
LOG_FORMAT=json
API_DOCS_ENABLED=false
# Browser origins allowed to call the API: staff panel + customer portal (https only).
API_CORS_ORIGINS=https://staff.example.com,https://service.example.com
AUTH_COOKIE_SECURE=true
AUTH_RATE_LIMIT_PER_MINUTE=10
AUDIT_STORE_CLIENT_METADATA=false

# ---- Secrets (generate; store copies in your password manager)
JWT_ACCESS_SECRET=
OTP_PEPPER=
MFA_ENFORCEMENT=required
MFA_ENCRYPTION_KEY=
MFA_ISSUER=ICON Service

# ---- Storage (SeaweedFS on the private network; downloads via FILES domain)
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=icon-files
S3_PUBLIC_ENDPOINT=https://files.example.com
SIGNED_URL_TTL_SECONDS=300

# ---- Customer sign-in and notifications (ADR 0018) — fill once Meta/SMTP are approved
OTP_PROVIDER=whatsapp
WHATSAPP_PROVIDER=meta
WHATSAPP_API_BASE_URL=https://graph.facebook.com
WHATSAPP_GRAPH_API_VERSION=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_ORGANIZATION_CODE=
WHATSAPP_OTP_TEMPLATE_NAME=
WHATSAPP_OTP_TEMPLATE_LANGUAGE=en
EMAIL_PROVIDER=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
