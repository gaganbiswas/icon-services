{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test:integration": {
      "dependsOn": ["^build"],
      "cache": false,
      "env": [
        "DATABASE_URL",
        "TEST_DATABASE_URL",
        "REDIS_URL",
        "NODE_ENV",
        "JWT_ACCESS_SECRET",
        "OTP_PEPPER",
        "S3_*",
        "PDF_CHROMIUM_EXECUTABLE",
        "CI"
      ]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "@icon/database#typecheck": {
      "dependsOn": ["build"]
    },
    "@icon/database#lint": {
      "dependsOn": ["build"]
    },
    "@icon/database#test": {
      "dependsOn": ["build"],
      "outputs": []
    }
  }
}
