# ICON INFOSYS SERVICE MANAGEMENT — local development environment.
# Copy to `.env` (never commit `.env`). Values below are LOCAL-ONLY placeholders.
# Production secrets must come from a secrets manager (CLAUDE.md §8).

NODE_ENV=development

# ---- API (apps/api) ----
API_PORT=4000
# Comma-separated list of browser origins allowed to call the API.
API_CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# Serve OpenAPI docs at /api/docs (keep false in production unless approved).
API_DOCS_ENABLED=true
# log | error | warn | debug | verbose | fatal
LOG_LEVEL=log
# json (production) | pretty (local)
LOG_FORMAT=pretty

# ---- PostgreSQL (docker compose) ----
# 5433 by default to avoid clashing with a locally installed PostgreSQL on 5432.
POSTGRES_USER=icon
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=icon_service
POSTGRES_HOST_PORT=5433
DATABASE_URL=postgresql://icon:change-me-local-only@localhost:5433/icon_service?schema=public

# ---- Redis (docker compose) ----
# 6380 by default to avoid clashing with a locally installed Redis on 6379.
REDIS_HOST_PORT=6380
REDIS_URL=redis://localhost:6380

# ---- S3-compatible object storage: SeaweedFS (docker compose, ADR 0009) ----
S3_HOST_PORT=8333
S3_ENDPOINT=http://localhost:8333
S3_REGION=local
S3_ACCESS_KEY_ID=change-me-local-only
S3_SECRET_ACCESS_KEY=change-me-local-only-secret
S3_BUCKET=icon-dev
S3_FORCE_PATH_STYLE=true
