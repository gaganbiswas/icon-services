# ICON INFOSYS SERVICE MANAGEMENT — local development environment.
# Copy to `.env` (never commit `.env`). Values below are LOCAL-ONLY placeholders.
# Production secrets must come from a secrets manager (CLAUDE.md §8).

NODE_ENV=development

# ---- API (apps/api) ----
API_PORT=4000
# Comma-separated list of browser origins allowed to call the API.
API_CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# Serve OpenAPI docs at /api/docs (keep false in production unless approved).
API_DOCS_ENABLED=true
# log | error | warn | debug | verbose | fatal
LOG_LEVEL=log
# json (production) | pretty (local)
LOG_FORMAT=pretty

# ---- PostgreSQL (docker compose) ----
# 5433 by default to avoid clashing with a locally installed PostgreSQL on 5432.
POSTGRES_USER=icon
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=icon_service
POSTGRES_HOST_PORT=5433
DATABASE_URL=postgresql://icon:change-me-local-only@localhost:5433/icon_service?schema=public

# ---- Redis (docker compose) ----
# 6380 by default to avoid clashing with a locally installed Redis on 6379.
REDIS_HOST_PORT=6380
REDIS_URL=redis://localhost:6380

# ---- S3-compatible object storage: SeaweedFS (docker compose, ADR 0009) ----
S3_HOST_PORT=8333
S3_ENDPOINT=http://localhost:8333
S3_REGION=local
S3_ACCESS_KEY_ID=change-me-local-only
S3_SECRET_ACCESS_KEY=change-me-local-only-secret
S3_BUCKET=icon-dev
S3_FORCE_PATH_STYLE=true

# ---- Integration tests ----
# Separate database; integration tests reset it. Never point this at real data.
TEST_DATABASE_URL=postgresql://icon:change-me-local-only@localhost:5433/icon_service_test?schema=public

# ---- Authentication (ADR 0010) ----
# HS256 signing key for staff access tokens. >= 32 random characters.
# Generate: openssl rand -base64 48   (never reuse between environments)
JWT_ACCESS_SECRET=change-me-local-only-use-openssl-rand-base64-48
JWT_ISSUER=icon-service-api
JWT_AUDIENCE=icon-service-staff
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_IDLE_TTL_DAYS=7
SESSION_ABSOLUTE_TTL_DAYS=30
# Secure cookies require HTTPS; false only for local http://localhost.
AUTH_COOKIE_SECURE=false
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
PASSWORD_SETUP_TOKEN_TTL_MINUTES=60
# Per-IP limit for sign-in and password endpoints.
AUTH_RATE_LIMIT_PER_MINUTE=10
# Store client IP / user agent on sessions and audit rows ("where lawful",
# owner question G56). Defaults to false when unset.
AUDIT_STORE_CLIENT_METADATA=true

# ---- Two-step sign-in / MFA (ADR 0011) ----
# required = privileged staff must use an authenticator app (mandatory in production).
MFA_ENFORCEMENT=optional
# 32 random bytes, base64: openssl rand -base64 32. Losing it disables everyone's MFA (reset needed).
MFA_ENCRYPTION_KEY=
MFA_ISSUER=ICON Service

# ---- Notification providers (ADR 0018) ----
# mock = development only (refused in production); disabled = record SKIPPED_NOT_CONFIGURED.
WHATSAPP_PROVIDER=mock
# Meta WhatsApp Cloud API. Secrets belong in the secrets manager in production.
WHATSAPP_API_BASE_URL=https://graph.facebook.com
WHATSAPP_GRAPH_API_VERSION=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_ORGANIZATION_CODE=
WHATSAPP_OTP_TEMPLATE_NAME=
WHATSAPP_OTP_TEMPLATE_LANGUAGE=en
# smtp | mock | disabled. Locally, Mailpit captures mail (UI on http://localhost:8025).
EMAIL_PROVIDER=mock
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=ICON Service <no-reply@example.test>

# ---- Customer sign-in (ADR 0012/0018) ----
# mock (development only, logs codes locally) | whatsapp (approved authentication template).
OTP_PROVIDER=mock
OTP_PEPPER=change-me-local-only-use-openssl-rand-base64-48
SIGNED_URL_TTL_SECONDS=300

# ---- Development seed only (packages/database: bun run db:seed:dev) ----
# The seed refuses to run when NODE_ENV=production. No defaults are built in.
SEED_ADMIN_EMAIL=admin@example.test
SEED_ADMIN_PASSWORD=
