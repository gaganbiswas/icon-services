{
  "name": "icon-infosys-service-management",
  "private": true,
  "packageManager": "bun@1.4.4",
  "engines": {
    "node": ">=24.3.0 <25",
    "bun": ">=1.4.4"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "bun run format:check && turbo run lint typecheck test build",
    "services:up": "docker compose up -d --wait",
    "services:down": "docker compose down",
    "audit": "bun audit --audit-level=high --ignore=GHSA-fc5q-39xc-vjpf"
  },
  "devDependencies": {
    "prettier": "3.10.1",
    "turbo": "2.11.12",
    "typescript": "6.0.3"
  }
}
