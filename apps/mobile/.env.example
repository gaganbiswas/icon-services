# Android customer app (Expo). Only EXPO_PUBLIC_* values are bundled into the
# app — never put secrets here.
# Android emulator reaches the host machine at 10.0.2.2; a physical device needs
# the computer's LAN IP. Production must use HTTPS.
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:4000
# Organization this app build serves (placeholder dev organization).
EXPO_PUBLIC_ORGANIZATION_CODE=DEV
