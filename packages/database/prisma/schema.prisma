// ICON INFOSYS SERVICE MANAGEMENT — Prisma schema (PostgreSQL 17).
//
// Conventions (CLAUDE.md §6, docs/database-dictionary.md):
// - UUID primary keys (UUIDv7, generated by Prisma), snake_case tables/columns.
// - UTC timestamps as timestamptz(3).
// - Money as NUMERIC(19,4) (ADR 0005) — no money columns yet.
// - Financial records and audit history are never hard-deleted.
//
// Phase 2: tenancy, identity, RBAC, sessions and audit.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  runtime             = "nodejs"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Tenancy
// ---------------------------------------------------------------------------

model Organization {
  id              String   @id @default(uuid(7)) @db.Uuid
  code            String   @unique @db.VarChar(20)
  /// Legal name — not yet confirmed by the owner (owner question B7).
  legalName       String?  @map("legal_name") @db.VarChar(300)
  displayName     String   @map("display_name") @db.VarChar(200)
  /// ISO 4217. Not assumed (owner question B11).
  defaultCurrency String?  @map("default_currency") @db.Char(3)
  /// IANA time zone. Not assumed (owner question B12).
  timezone        String?  @db.VarChar(64)
  /// ISO 3166-1 alpha-2.
  countryCode     String?  @map("country_code") @db.Char(2)
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  branches  Branch[]
  users     User[]
  roles     Role[]
  auditLogs AuditLog[]

  @@map("organizations")
}

model Branch {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  code           String   @db.VarChar(20)
  name           String   @db.VarChar(200)
  addressLine1   String?  @map("address_line1") @db.VarChar(200)
  addressLine2   String?  @map("address_line2") @db.VarChar(200)
  city           String?  @db.VarChar(100)
  region         String?  @db.VarChar(100)
  postalCode     String?  @map("postal_code") @db.VarChar(20)
  countryCode    String?  @map("country_code") @db.Char(2)
  phone          String?  @db.VarChar(32)
  email          String?  @db.VarChar(254)
  timezone       String?  @db.VarChar(64)
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  userAccess   UserBranchAccess[]

  @@unique([organizationId, code])
  @@unique([organizationId, id])
  @@index([organizationId])
  @@map("branches")
}

// ---------------------------------------------------------------------------
// Identity and RBAC
// ---------------------------------------------------------------------------

model User {
  id                 String    @id @default(uuid(7)) @db.Uuid
  organizationId     String    @map("organization_id") @db.Uuid
  /// E-mail as entered (display value).
  email              String    @db.VarChar(254)
  /// Lower-cased, trimmed e-mail used for login lookup. Globally unique.
  emailNormalized    String    @unique @map("email_normalized") @db.VarChar(254)
  fullName           String    @map("full_name") @db.VarChar(200)
  /// Argon2id PHC string. Null until the user completes password set-up.
  passwordHash       String?   @map("password_hash") @db.VarChar(255)
  passwordChangedAt  DateTime? @map("password_changed_at") @db.Timestamptz(3)
  mustChangePassword Boolean   @default(false) @map("must_change_password")
  isActive           Boolean   @default(true) @map("is_active")
  failedLoginCount   Int       @default(0) @map("failed_login_count")
  lockedUntil        DateTime? @map("locked_until") @db.Timestamptz(3)
  lastLoginAt        DateTime? @map("last_login_at") @db.Timestamptz(3)
  /// Optimistic concurrency version.
  version            Int       @default(1)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization        Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  roles               UserRole[]           @relation("UserRoles")
  branchAccess        UserBranchAccess[]   @relation("UserBranchAccess")
  sessions            AuthSession[]
  passwordSetupTokens PasswordSetupToken[] @relation("PasswordSetupTokenUser")

  @@unique([organizationId, id])
  @@index([organizationId])
  @@map("users")
}

/// Global permission catalogue; codes come from packages/contracts.
model Permission {
  id          String   @id @default(uuid(7)) @db.Uuid
  code        String   @unique @db.VarChar(100)
  description String   @db.VarChar(300)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  roles RolePermission[]

  @@map("permissions")
}

model Role {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  code           String   @db.VarChar(50)
  name           String   @db.VarChar(100)
  description    String?  @db.VarChar(500)
  /// Seeded role; cannot be deleted or renamed by code.
  isSystem       Boolean  @default(false) @map("is_system")
  version        Int      @default(1)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  permissions  RolePermission[]
  users        UserRole[]

  @@unique([organizationId, code])
  @@unique([organizationId, id])
  @@index([organizationId])
  @@map("roles")
}

model RolePermission {
  roleId       String   @map("role_id") @db.Uuid
  permissionId String   @map("permission_id") @db.Uuid
  grantedAt    DateTime @default(now()) @map("granted_at") @db.Timestamptz(3)

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

/// organization_id + composite foreign keys guarantee user and role belong
/// to the same organization (database-level tenant integrity).
model UserRole {
  organizationId String   @map("organization_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  roleId         String   @map("role_id") @db.Uuid
  assignedById   String?  @map("assigned_by_id") @db.Uuid
  assignedAt     DateTime @default(now()) @map("assigned_at") @db.Timestamptz(3)

  user User @relation("UserRoles", fields: [organizationId, userId], references: [organizationId, id], onDelete: Restrict)
  role Role @relation(fields: [organizationId, roleId], references: [organizationId, id], onDelete: Restrict)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

/// organization_id + composite foreign keys guarantee user and branch belong
/// to the same organization.
model UserBranchAccess {
  organizationId String   @map("organization_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  branchId       String   @map("branch_id") @db.Uuid
  grantedById    String?  @map("granted_by_id") @db.Uuid
  grantedAt      DateTime @default(now()) @map("granted_at") @db.Timestamptz(3)

  user   User   @relation("UserBranchAccess", fields: [organizationId, userId], references: [organizationId, id], onDelete: Restrict)
  branch Branch @relation(fields: [organizationId, branchId], references: [organizationId, id], onDelete: Restrict)

  @@id([userId, branchId])
  @@index([branchId])
  @@map("user_branch_access")
}

// ---------------------------------------------------------------------------
// Sessions and tokens (ADR 0010)
// ---------------------------------------------------------------------------

/// One login = one session = one refresh-token family.
model AuthSession {
  id            String    @id @default(uuid(7)) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  lastUsedAt    DateTime  @default(now()) @map("last_used_at") @db.Timestamptz(3)
  /// Absolute expiry; refresh cannot extend beyond this.
  expiresAt     DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt     DateTime? @map("revoked_at") @db.Timestamptz(3)
  /// LOGOUT | REFRESH_TOKEN_REUSE | PASSWORD_CHANGED | PASSWORD_RESET | USER_DEACTIVATED | ADMIN
  revokedReason String?   @map("revoked_reason") @db.VarChar(50)
  /// Stored only when AUDIT_STORE_CLIENT_METADATA=true.
  ipAddress     String?   @map("ip_address") @db.VarChar(45)
  userAgent     String?   @map("user_agent") @db.VarChar(500)

  user          User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  refreshTokens RefreshToken[]

  @@index([userId])
  @@map("auth_sessions")
}

model RefreshToken {
  id        String    @id @default(uuid(7)) @db.Uuid
  sessionId String    @map("session_id") @db.Uuid
  /// SHA-256 (hex) of the opaque token. The token itself is never stored.
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)

  session AuthSession @relation(fields: [sessionId], references: [id], onDelete: Restrict)

  @@index([sessionId])
  @@map("refresh_tokens")
}

/// One-time token for initial password set-up or admin-issued reset.
model PasswordSetupToken {
  id         String    @id @default(uuid(7)) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  /// SHA-256 (hex) of the token. The token itself is never stored.
  tokenHash  String    @unique @map("token_hash") @db.Char(64)
  /// INITIAL_SETUP | ADMIN_RESET
  purpose    String    @db.VarChar(20)
  issuedById String?   @map("issued_by_id") @db.Uuid
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt     DateTime? @map("used_at") @db.Timestamptz(3)
  /// Set when a newer token supersedes this one.
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(3)

  user User @relation("PasswordSetupTokenUser", fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@map("password_setup_tokens")
}

// ---------------------------------------------------------------------------
// Audit (append-only; UPDATE/DELETE blocked by trigger in migration SQL)
// ---------------------------------------------------------------------------

enum AuditActorType {
  USER
  SYSTEM
  ANONYMOUS

  @@map("audit_actor_type")
}

model AuditLog {
  id             String         @id @default(uuid(7)) @db.Uuid
  organizationId String?        @map("organization_id") @db.Uuid
  branchId       String?        @map("branch_id") @db.Uuid
  actorType      AuditActorType @map("actor_type")
  actorUserId    String?        @map("actor_user_id") @db.Uuid
  /// Dotted action name, e.g. "auth.login.succeeded", "user.updated".
  action         String         @db.VarChar(100)
  entityType     String         @map("entity_type") @db.VarChar(100)
  entityId       String?        @map("entity_id") @db.VarChar(100)
  /// Redacted snapshots — never contain secrets or password hashes.
  before         Json?
  after          Json?
  reason         String?        @db.VarChar(1000)
  requestId      String?        @map("request_id") @db.VarChar(100)
  /// Stored only when AUDIT_STORE_CLIENT_METADATA=true.
  ipAddress      String?        @map("ip_address") @db.VarChar(45)
  userAgent      String?        @map("user_agent") @db.VarChar(500)
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([organizationId, createdAt(sort: Desc)])
  @@index([entityType, entityId])
  @@index([actorUserId, createdAt(sort: Desc)])
  @@map("audit_logs")
}
