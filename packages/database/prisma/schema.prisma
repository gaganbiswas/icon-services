// ICON INFOSYS SERVICE MANAGEMENT — Prisma schema (PostgreSQL 17).
//
// Conventions (CLAUDE.md §6, docs/database-dictionary.md):
// - UUID primary keys (UUIDv7, generated by Prisma), snake_case tables/columns.
// - UTC timestamps as timestamptz(3).
// - Money as NUMERIC(19,4) (ADR 0005) — no money columns yet.
// - Financial records and audit history are never hard-deleted.
//
// Phase 2: tenancy, identity, RBAC, sessions and audit.
// Phase 3: customers, assets, files, intake, numbering, settings, documents.
// Phase 4: lifecycle, assignments, diagnoses, work logs, notification outbox.
// Phase 5: estimates, lines, customer decisions, approval links.
// Phase 6: parts, suppliers, branch stock, stock ledger, job parts.
// Phase 8: payments, refunds (allocation to invoices arrives with Phase 7).
// Phase 9: deliveries, delivery items, challans.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  runtime             = "nodejs"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Tenancy
// ---------------------------------------------------------------------------

model Organization {
  id              String   @id @default(uuid(7)) @db.Uuid
  code            String   @unique @db.VarChar(20)
  /// Legal name — not yet confirmed by the owner (owner question B7).
  legalName       String?  @map("legal_name") @db.VarChar(300)
  displayName     String   @map("display_name") @db.VarChar(200)
  /// ISO 4217. Not assumed (owner question B11).
  defaultCurrency String?  @map("default_currency") @db.Char(3)
  /// IANA time zone. Not assumed (owner question B12).
  timezone        String?  @db.VarChar(64)
  /// ISO 3166-1 alpha-2.
  countryCode     String?  @map("country_code") @db.Char(2)
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  branches        Branch[]
  users           User[]
  roles           Role[]
  auditLogs       AuditLog[]
  customers       Customer[]
  assetCategories AssetCategory[]
  assets          Asset[]
  files           StoredFile[]
  serviceJobs     ServiceJob[]
  documents       Document[]
  settings        BusinessSetting[]

  @@map("organizations")
}

model Branch {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  code           String   @db.VarChar(20)
  name           String   @db.VarChar(200)
  addressLine1   String?  @map("address_line1") @db.VarChar(200)
  addressLine2   String?  @map("address_line2") @db.VarChar(200)
  city           String?  @db.VarChar(100)
  region         String?  @db.VarChar(100)
  postalCode     String?  @map("postal_code") @db.VarChar(20)
  countryCode    String?  @map("country_code") @db.Char(2)
  phone          String?  @db.VarChar(32)
  email          String?  @db.VarChar(254)
  timezone       String?  @db.VarChar(64)
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  userAccess   UserBranchAccess[]
  serviceJobs  ServiceJob[]

  @@unique([organizationId, code])
  @@unique([organizationId, id])
  @@index([organizationId])
  @@map("branches")
}

// ---------------------------------------------------------------------------
// Identity and RBAC
// ---------------------------------------------------------------------------

model User {
  id                 String    @id @default(uuid(7)) @db.Uuid
  organizationId     String    @map("organization_id") @db.Uuid
  /// E-mail as entered (display value).
  email              String    @db.VarChar(254)
  /// Lower-cased, trimmed e-mail used for login lookup. Globally unique.
  emailNormalized    String    @unique @map("email_normalized") @db.VarChar(254)
  fullName           String    @map("full_name") @db.VarChar(200)
  /// Argon2id PHC string. Null until the user completes password set-up.
  passwordHash       String?   @map("password_hash") @db.VarChar(255)
  passwordChangedAt  DateTime? @map("password_changed_at") @db.Timestamptz(3)
  mustChangePassword Boolean   @default(false) @map("must_change_password")
  isActive           Boolean   @default(true) @map("is_active")
  failedLoginCount   Int       @default(0) @map("failed_login_count")
  lockedUntil        DateTime? @map("locked_until") @db.Timestamptz(3)
  lastLoginAt        DateTime? @map("last_login_at") @db.Timestamptz(3)
  /// Optimistic concurrency version.
  version            Int       @default(1)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization        Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  assignments         JobAssignment[]       @relation("AssignedTechnician")
  diagnoses           Diagnosis[]
  workLogs            WorkLog[]
  roles               UserRole[]            @relation("UserRoles")
  branchAccess        UserBranchAccess[]    @relation("UserBranchAccess")
  sessions            AuthSession[]
  passwordSetupTokens PasswordSetupToken[]  @relation("PasswordSetupTokenUser")
  mfa                 UserMfa?
  mfaRecoveryCodes    UserMfaRecoveryCode[]
  mfaChallenges       MfaChallenge[]

  @@unique([organizationId, id])
  @@index([organizationId])
  @@map("users")
}

/// Global permission catalogue; codes come from packages/contracts.
model Permission {
  id          String   @id @default(uuid(7)) @db.Uuid
  code        String   @unique @db.VarChar(100)
  description String   @db.VarChar(300)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  roles RolePermission[]

  @@map("permissions")
}

model Role {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  code           String   @db.VarChar(50)
  name           String   @db.VarChar(100)
  description    String?  @db.VarChar(500)
  /// Seeded role; cannot be deleted or renamed by code.
  isSystem       Boolean  @default(false) @map("is_system")
  version        Int      @default(1)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  permissions  RolePermission[]
  users        UserRole[]

  @@unique([organizationId, code])
  @@unique([organizationId, id])
  @@index([organizationId])
  @@map("roles")
}

model RolePermission {
  roleId       String   @map("role_id") @db.Uuid
  permissionId String   @map("permission_id") @db.Uuid
  grantedAt    DateTime @default(now()) @map("granted_at") @db.Timestamptz(3)

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

/// organization_id + composite foreign keys guarantee user and role belong
/// to the same organization (database-level tenant integrity).
model UserRole {
  organizationId String   @map("organization_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  roleId         String   @map("role_id") @db.Uuid
  assignedById   String?  @map("assigned_by_id") @db.Uuid
  assignedAt     DateTime @default(now()) @map("assigned_at") @db.Timestamptz(3)

  user User @relation("UserRoles", fields: [organizationId, userId], references: [organizationId, id], onDelete: Restrict)
  role Role @relation(fields: [organizationId, roleId], references: [organizationId, id], onDelete: Restrict)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

/// organization_id + composite foreign keys guarantee user and branch belong
/// to the same organization.
model UserBranchAccess {
  organizationId String   @map("organization_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  branchId       String   @map("branch_id") @db.Uuid
  grantedById    String?  @map("granted_by_id") @db.Uuid
  grantedAt      DateTime @default(now()) @map("granted_at") @db.Timestamptz(3)

  user   User   @relation("UserBranchAccess", fields: [organizationId, userId], references: [organizationId, id], onDelete: Restrict)
  branch Branch @relation(fields: [organizationId, branchId], references: [organizationId, id], onDelete: Restrict)

  @@id([userId, branchId])
  @@index([branchId])
  @@map("user_branch_access")
}

// ---------------------------------------------------------------------------
// Sessions and tokens (ADR 0010)
// ---------------------------------------------------------------------------

enum SessionSubjectType {
  STAFF
  CUSTOMER

  @@map("session_subject_type")
}

/// One login = one session = one refresh-token family. Exactly one of
/// user_id (staff) / customer_id (customer) is set (CHECK in migration).
model AuthSession {
  id            String             @id @default(uuid(7)) @db.Uuid
  subjectType   SessionSubjectType @default(STAFF) @map("subject_type")
  userId        String?            @map("user_id") @db.Uuid
  customerId    String?            @map("customer_id") @db.Uuid
  createdAt     DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  lastUsedAt    DateTime           @default(now()) @map("last_used_at") @db.Timestamptz(3)
  /// Absolute expiry; refresh cannot extend beyond this.
  expiresAt     DateTime           @map("expires_at") @db.Timestamptz(3)
  revokedAt     DateTime?          @map("revoked_at") @db.Timestamptz(3)
  /// LOGOUT | REFRESH_TOKEN_REUSE | PASSWORD_CHANGED | PASSWORD_RESET | USER_DEACTIVATED | ADMIN
  revokedReason String?            @map("revoked_reason") @db.VarChar(50)
  /// Stored only when AUDIT_STORE_CLIENT_METADATA=true.
  ipAddress     String?            @map("ip_address") @db.VarChar(45)
  userAgent     String?            @map("user_agent") @db.VarChar(500)

  user          User?          @relation(fields: [userId], references: [id], onDelete: Restrict)
  customer      Customer?      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  refreshTokens RefreshToken[]

  @@index([userId])
  @@index([customerId])
  @@map("auth_sessions")
}

model RefreshToken {
  id        String    @id @default(uuid(7)) @db.Uuid
  sessionId String    @map("session_id") @db.Uuid
  /// SHA-256 (hex) of the opaque token. The token itself is never stored.
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)

  session AuthSession @relation(fields: [sessionId], references: [id], onDelete: Restrict)

  @@index([sessionId])
  @@map("refresh_tokens")
}

/// One-time token for initial password set-up or admin-issued reset.
model PasswordSetupToken {
  id         String    @id @default(uuid(7)) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  /// SHA-256 (hex) of the token. The token itself is never stored.
  tokenHash  String    @unique @map("token_hash") @db.Char(64)
  /// INITIAL_SETUP | ADMIN_RESET
  purpose    String    @db.VarChar(20)
  issuedById String?   @map("issued_by_id") @db.Uuid
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt     DateTime? @map("used_at") @db.Timestamptz(3)
  /// Set when a newer token supersedes this one.
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(3)

  user User @relation("PasswordSetupTokenUser", fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@map("password_setup_tokens")
}

// ---------------------------------------------------------------------------
// Audit (append-only; UPDATE/DELETE blocked by trigger in migration SQL)
// ---------------------------------------------------------------------------

enum AuditActorType {
  USER
  SYSTEM
  ANONYMOUS

  @@map("audit_actor_type")
}

model AuditLog {
  id             String         @id @default(uuid(7)) @db.Uuid
  organizationId String?        @map("organization_id") @db.Uuid
  branchId       String?        @map("branch_id") @db.Uuid
  actorType      AuditActorType @map("actor_type")
  actorUserId    String?        @map("actor_user_id") @db.Uuid
  /// Dotted action name, e.g. "auth.login.succeeded", "user.updated".
  action         String         @db.VarChar(100)
  entityType     String         @map("entity_type") @db.VarChar(100)
  entityId       String?        @map("entity_id") @db.VarChar(100)
  /// Redacted snapshots — never contain secrets or password hashes.
  before         Json?
  after          Json?
  reason         String?        @db.VarChar(1000)
  requestId      String?        @map("request_id") @db.VarChar(100)
  /// Stored only when AUDIT_STORE_CLIENT_METADATA=true.
  ipAddress      String?        @map("ip_address") @db.VarChar(45)
  userAgent      String?        @map("user_agent") @db.VarChar(500)
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([organizationId, createdAt(sort: Desc)])
  @@index([entityType, entityId])
  @@index([actorUserId, createdAt(sort: Desc)])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// Settings and numbering (ADR 0012)
// ---------------------------------------------------------------------------

/// Scoped configuration. Values are validated by Zod schemas in
/// packages/contracts (settings.ts) on every write and read.
model BusinessSetting {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  key            String   @db.VarChar(100)
  value          Json
  version        Int      @default(1)
  updatedById    String?  @map("updated_by_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([organizationId, key])
  @@map("business_settings")
}

/// Counters for human-readable numbers. Incremented atomically with
/// INSERT … ON CONFLICT DO UPDATE … RETURNING inside the business transaction.
/// branch_scope is the branch ID, or '-' for organization-wide sequences
/// (avoids NULLs in the unique key).
model NumberSequence {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  branchScope    String   @map("branch_scope") @db.VarChar(36)
  documentType   String   @map("document_type") @db.VarChar(40)
  /// e.g. "2026" for yearly reset, "ALL" for never.
  periodKey      String   @map("period_key") @db.VarChar(20)
  currentValue   BigInt   @map("current_value")
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([organizationId, branchScope, documentType, periodKey])
  @@map("number_sequences")
}

/// Idempotency records for retried writes (CLAUDE.md §7).
model IdempotencyKey {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  /// "user:<uuid>" or "customer:<uuid>"
  actorKey       String   @map("actor_key") @db.VarChar(80)
  operation      String   @db.VarChar(60)
  key            String   @db.VarChar(100)
  requestHash    String   @map("request_hash") @db.Char(64)
  responseStatus Int?     @map("response_status")
  responseBody   Json?    @map("response_body")
  resourceId     String?  @map("resource_id") @db.VarChar(100)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt      DateTime @map("expires_at") @db.Timestamptz(3)

  @@unique([actorKey, operation, key])
  @@index([expiresAt])
  @@map("idempotency_keys")
}

// ---------------------------------------------------------------------------
// Customers
// ---------------------------------------------------------------------------

enum CustomerType {
  INDIVIDUAL
  BUSINESS

  @@map("customer_type")
}

enum CustomerStatus {
  ACTIVE
  ANONYMIZED

  @@map("customer_status")
}

model Customer {
  id                String         @id @default(uuid(7)) @db.Uuid
  organizationId    String         @map("organization_id") @db.Uuid
  customerCode      String         @map("customer_code") @db.VarChar(30)
  type              CustomerType
  /// Full name, or legal business name for BUSINESS customers.
  name              String         @db.VarChar(200)
  contactPerson     String?        @map("contact_person") @db.VarChar(200)
  phoneE164         String         @map("phone_e164") @db.VarChar(16)
  phoneDisplay      String         @map("phone_display") @db.VarChar(32)
  altPhoneE164      String?        @map("alt_phone_e164") @db.VarChar(16)
  altPhoneDisplay   String?        @map("alt_phone_display") @db.VarChar(32)
  email             String?        @db.VarChar(254)
  /// Optional tax identity (e.g. GSTIN) — unvalidated until jurisdiction confirmed.
  taxIdentifier     String?        @map("tax_identifier") @db.VarChar(30)
  /// BCP 47 language tag.
  preferredLanguage String?        @map("preferred_language") @db.VarChar(20)
  notes             String?        @db.VarChar(2000)
  status            CustomerStatus @default(ACTIVE)
  createdById       String?        @map("created_by_id") @db.Uuid
  /// INTAKE_STAFF | CUSTOMER_APP | WEB_PORTAL
  source            String         @default("INTAKE_STAFF") @db.VarChar(20)
  version           Int            @default(1)
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  anonymizedAt      DateTime?      @map("anonymized_at") @db.Timestamptz(3)

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  addresses    CustomerAddress[]
  consents     CustomerConsent[]
  assets       Asset[]
  serviceJobs  ServiceJob[]
  sessions     AuthSession[]

  @@unique([organizationId, customerCode])
  @@unique([organizationId, id])
  @@index([organizationId, phoneE164])
  @@index([organizationId, altPhoneE164])
  @@index([organizationId, email])
  @@map("customers")
}

enum AddressKind {
  BILLING
  SERVICE

  @@map("address_kind")
}

model CustomerAddress {
  id          String      @id @default(uuid(7)) @db.Uuid
  customerId  String      @map("customer_id") @db.Uuid
  kind        AddressKind
  line1       String      @db.VarChar(200)
  line2       String?     @db.VarChar(200)
  city        String      @db.VarChar(100)
  region      String?     @db.VarChar(100)
  postalCode  String?     @map("postal_code") @db.VarChar(20)
  /// ISO 3166-1 alpha-2.
  countryCode String      @map("country_code") @db.Char(2)
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  @@unique([customerId, kind])
  @@map("customer_addresses")
}

enum ConsentChannel {
  WHATSAPP
  EMAIL
  SMS
  PUSH

  @@map("consent_channel")
}

enum ConsentPurpose {
  SERVICE_UPDATES
  MARKETING

  @@map("consent_purpose")
}

/// Append-only consent records. The active consent for a channel/purpose is
/// the latest row with withdrawn_at IS NULL (partial unique index in SQL).
model CustomerConsent {
  id              String         @id @default(uuid(7)) @db.Uuid
  organizationId  String         @map("organization_id") @db.Uuid
  customerId      String         @map("customer_id") @db.Uuid
  channel         ConsentChannel
  purpose         ConsentPurpose
  policyVersion   String         @map("policy_version") @db.VarChar(50)
  /// STAFF_ENTRY | CUSTOMER_APP | WEB_PORTAL
  source          String         @db.VarChar(20)
  recordedById    String?        @map("recorded_by_id") @db.Uuid
  grantedAt       DateTime       @default(now()) @map("granted_at") @db.Timestamptz(3)
  withdrawnAt     DateTime?      @map("withdrawn_at") @db.Timestamptz(3)
  withdrawnSource String?        @map("withdrawn_source") @db.VarChar(20)

  customer Customer @relation(fields: [organizationId, customerId], references: [organizationId, id], onDelete: Restrict)

  @@index([customerId])
  @@map("customer_consents")
}

// ---------------------------------------------------------------------------
// Assets (devices)
// ---------------------------------------------------------------------------

model AssetCategory {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  code           String   @db.VarChar(30)
  name           String   @db.VarChar(100)
  isActive       Boolean  @default(true) @map("is_active")
  sortOrder      Int      @default(0) @map("sort_order")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  assets       Asset[]

  @@unique([organizationId, code])
  @@unique([organizationId, id])
  @@map("asset_categories")
}

model Asset {
  id                    String    @id @default(uuid(7)) @db.Uuid
  organizationId        String    @map("organization_id") @db.Uuid
  customerId            String    @map("customer_id") @db.Uuid
  categoryId            String    @map("category_id") @db.Uuid
  brand                 String    @db.VarChar(100)
  model                 String    @db.VarChar(150)
  serialNumber          String?   @map("serial_number") @db.VarChar(100)
  /// Upper-cased, whitespace/dash-free serial for duplicate detection.
  serialNormalized      String?   @map("serial_normalized") @db.VarChar(100)
  assetTag              String?   @map("asset_tag") @db.VarChar(100)
  purchaseDate          DateTime? @map("purchase_date") @db.Date
  warrantyStart         DateTime? @map("warranty_start") @db.Date
  warrantyEnd           DateTime? @map("warranty_end") @db.Date
  warrantyProvider      String?   @map("warranty_provider") @db.VarChar(150)
  warrantyReference     String?   @map("warranty_reference") @db.VarChar(150)
  proofOfPurchaseFileId String?   @map("proof_of_purchase_file_id") @db.Uuid
  /// Category-specific attributes validated by packages/contracts schemas.
  attributes            Json      @default("{}")
  isActive              Boolean   @default(true) @map("is_active")
  version               Int       @default(1)
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization    Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  customer        Customer      @relation(fields: [organizationId, customerId], references: [organizationId, id], onDelete: Restrict)
  category        AssetCategory @relation(fields: [organizationId, categoryId], references: [organizationId, id], onDelete: Restrict)
  proofOfPurchase StoredFile?   @relation("AssetProofOfPurchase", fields: [proofOfPurchaseFileId], references: [id], onDelete: Restrict)
  serviceJobs     ServiceJob[]

  @@unique([organizationId, id])
  @@index([organizationId, serialNormalized])
  @@index([customerId])
  @@map("assets")
}

// ---------------------------------------------------------------------------
// Files
// ---------------------------------------------------------------------------

enum FileClassification {
  /// Customer personal data or customer-supplied files.
  PERSONAL
  /// Staff-only operational files.
  INTERNAL
  /// Generated business documents (receipts, invoices).
  DOCUMENT

  @@map("file_classification")
}

model StoredFile {
  id                   String             @id @default(uuid(7)) @db.Uuid
  organizationId       String             @map("organization_id") @db.Uuid
  /// Random object key; never derived from user input.
  storageKey           String             @unique @map("storage_key") @db.VarChar(200)
  originalName         String             @map("original_name") @db.VarChar(255)
  /// Sniffed from content, not trusted from the client.
  mimeType             String             @map("mime_type") @db.VarChar(100)
  sizeBytes            Int                @map("size_bytes")
  sha256               String             @db.Char(64)
  classification       FileClassification
  uploadedByUserId     String?            @map("uploaded_by_user_id") @db.Uuid
  uploadedByCustomerId String?            @map("uploaded_by_customer_id") @db.Uuid
  createdAt            DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  assetProofs    Asset[]         @relation("AssetProofOfPurchase")
  jobAttachments JobAttachment[]
  documents      Document[]

  @@unique([organizationId, id])
  @@map("files")
}

// ---------------------------------------------------------------------------
// Service jobs
// ---------------------------------------------------------------------------

enum ServiceType {
  IN_WARRANTY
  OUT_OF_WARRANTY
  WARRANTY_UNVERIFIED

  @@map("service_type")
}

enum ServiceMode {
  AT_SERVICE_CENTRE
  ON_SITE

  @@map("service_mode")
}

enum JobStatus {
  AWAITING_DEVICE
  RECEIVED
  WARRANTY_CHECK
  DIAGNOSIS
  ESTIMATE_PREPARATION
  AWAITING_CUSTOMER_APPROVAL
  WAITING_FOR_PARTS
  REPAIR_IN_PROGRESS
  QUALITY_CHECK
  REPAIR_COMPLETED
  READY_FOR_DELIVERY
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  ON_HOLD

  @@map("job_status")
}

enum WarrantyVerification {
  NOT_CHECKED
  VERIFIED
  REJECTED

  @@map("warranty_verification")
}

enum IntakeChannel {
  STAFF
  CUSTOMER_APP
  WEB_PORTAL

  @@map("intake_channel")
}

model ServiceJob {
  id                     String               @id @default(uuid(7)) @db.Uuid
  organizationId         String               @map("organization_id") @db.Uuid
  branchId               String               @map("branch_id") @db.Uuid
  jobNumber              String               @map("job_number") @db.VarChar(40)
  customerId             String               @map("customer_id") @db.Uuid
  assetId                String               @map("asset_id") @db.Uuid
  serviceType            ServiceType          @map("service_type")
  serviceMode            ServiceMode          @map("service_mode")
  /// Complaint in the customer's own words.
  complaint              String               @db.VarChar(4000)
  /// [{ item, checked, note? }] — configurable checklist, validated in contracts.
  intakeChecklist        Json                 @default("[]") @map("intake_checklist")
  accessoriesReceived    String[]             @default([]) @map("accessories_received")
  conditionNotes         String?              @map("condition_notes") @db.VarChar(2000)
  /// Service address snapshot for ON_SITE jobs.
  serviceAddress         Json?                @map("service_address")
  channel                IntakeChannel
  status                 JobStatus
  receivedAt             DateTime?            @map("received_at") @db.Timestamptz(3)
  receivedById           String?              @map("received_by_id") @db.Uuid
  expectedCompletionDate DateTime?            @map("expected_completion_date") @db.Date
  warrantyVerification   WarrantyVerification @default(NOT_CHECKED) @map("warranty_verification")
  warrantyVerifiedById   String?              @map("warranty_verified_by_id") @db.Uuid
  warrantyVerifiedAt     DateTime?            @map("warranty_verified_at") @db.Timestamptz(3)
  warrantyNotes          String?              @map("warranty_notes") @db.VarChar(2000)
  customerAcknowledgedAt DateTime?            @map("customer_acknowledged_at") @db.Timestamptz(3)
  /// SIGNED_PAPER | VERBAL | APP_SUBMISSION
  acknowledgementMethod  String?              @map("acknowledgement_method") @db.VarChar(30)
  /// Completion record required before REPAIR_COMPLETED (ADR 0013).
  repairSummary          String?              @map("repair_summary") @db.VarChar(4000)
  qcChecklist            Json?                @map("qc_checklist")
  completedById          String?              @map("completed_by_id") @db.Uuid
  completedAt            DateTime?            @map("completed_at") @db.Timestamptz(3)
  createdById            String?              @map("created_by_id") @db.Uuid
  createdByCustomerId    String?              @map("created_by_customer_id") @db.Uuid
  version                Int                  @default(1)
  createdAt              DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization  Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  branch        Branch             @relation(fields: [organizationId, branchId], references: [organizationId, id], onDelete: Restrict)
  customer      Customer           @relation(fields: [organizationId, customerId], references: [organizationId, id], onDelete: Restrict)
  asset         Asset              @relation(fields: [organizationId, assetId], references: [organizationId, id], onDelete: Restrict)
  statusHistory JobStatusHistory[]
  attachments   JobAttachment[]
  assignments   JobAssignment[]
  diagnoses     Diagnosis[]
  workLogs      WorkLog[]
  estimates     Estimate[]
  parts         JobPart[]
  deliveries    Delivery[]
  invoices      Invoice[]

  @@unique([organizationId, jobNumber])
  @@unique([organizationId, id])
  @@index([organizationId, branchId, status])
  @@index([organizationId, createdAt(sort: Desc)])
  @@index([customerId])
  @@index([assetId])
  @@map("service_jobs")
}

/// Append-only (UPDATE/DELETE blocked by trigger).
model JobStatusHistory {
  id              String     @id @default(uuid(7)) @db.Uuid
  jobId           String     @map("job_id") @db.Uuid
  fromStatus      JobStatus? @map("from_status")
  toStatus        JobStatus  @map("to_status")
  actorUserId     String?    @map("actor_user_id") @db.Uuid
  actorCustomerId String?    @map("actor_customer_id") @db.Uuid
  /// STAFF_WEB | CUSTOMER_APP | WEB_PORTAL | SYSTEM
  channel         String     @db.VarChar(20)
  reason          String?    @db.VarChar(1000)
  customerMessage String?    @map("customer_message") @db.VarChar(1000)
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)

  job ServiceJob @relation(fields: [jobId], references: [id], onDelete: Restrict)

  @@index([jobId, createdAt])
  @@map("job_status_history")
}

enum AttachmentVisibility {
  INTERNAL
  CUSTOMER

  @@map("attachment_visibility")
}

model JobAttachment {
  id         String               @id @default(uuid(7)) @db.Uuid
  jobId      String               @map("job_id") @db.Uuid
  fileId     String               @map("file_id") @db.Uuid
  /// INTAKE_PHOTO | WARRANTY_PROOF | CUSTOMER_PHOTO | OTHER
  category   String               @db.VarChar(30)
  visibility AttachmentVisibility
  createdAt  DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)

  job  ServiceJob @relation(fields: [jobId], references: [id], onDelete: Restrict)
  file StoredFile @relation(fields: [fileId], references: [id], onDelete: Restrict)

  @@unique([jobId, fileId])
  @@map("job_attachments")
}

// ---------------------------------------------------------------------------
// Generated documents
// ---------------------------------------------------------------------------

model Document {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  branchId       String?  @map("branch_id") @db.Uuid
  /// JOB_RECEIPT (later: ESTIMATE, INVOICE, PAYMENT_RECEIPT, DELIVERY_CHALLAN …)
  documentType   String   @map("document_type") @db.VarChar(30)
  entityType     String   @map("entity_type") @db.VarChar(50)
  entityId       String   @map("entity_id") @db.Uuid
  documentNumber String   @map("document_number") @db.VarChar(40)
  /// A4 | THERMAL_80
  layout         String   @db.VarChar(20)
  version        Int
  fileId         String   @map("file_id") @db.Uuid
  /// Immutable snapshot of the data rendered (reprints never change values).
  snapshot       Json
  generatedById  String?  @map("generated_by_id") @db.Uuid
  generatedAt    DateTime @default(now()) @map("generated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  file         StoredFile   @relation(fields: [fileId], references: [id], onDelete: Restrict)

  @@unique([entityType, entityId, documentType, layout, version])
  @@index([organizationId, documentType, generatedAt(sort: Desc)])
  @@map("documents")
}

// ---------------------------------------------------------------------------
// Customer one-time codes (ADR 0012)
// ---------------------------------------------------------------------------

model CustomerOtpChallenge {
  id             String    @id @default(uuid(7)) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  phoneE164      String    @map("phone_e164") @db.VarChar(16)
  /// HMAC-SHA256(code) with a server-side pepper, hex.
  codeHash       String    @map("code_hash") @db.Char(64)
  attempts       Int       @default(0)
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz(3)
  consumedAt     DateTime? @map("consumed_at") @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([organizationId, phoneE164, createdAt(sort: Desc)])
  @@map("customer_otp_challenges")
}

// ---------------------------------------------------------------------------
// Technician work (Phase 4, ADR 0013)
// ---------------------------------------------------------------------------

/// Assignment history: rows are ended, never deleted.
model JobAssignment {
  id               String    @id @default(uuid(7)) @db.Uuid
  jobId            String    @map("job_id") @db.Uuid
  technicianUserId String    @map("technician_user_id") @db.Uuid
  assignedById     String    @map("assigned_by_id") @db.Uuid
  note             String?   @db.VarChar(500)
  assignedAt       DateTime  @default(now()) @map("assigned_at") @db.Timestamptz(3)
  endedAt          DateTime? @map("ended_at") @db.Timestamptz(3)
  endedById        String?   @map("ended_by_id") @db.Uuid

  job        ServiceJob @relation(fields: [jobId], references: [id], onDelete: Restrict)
  technician User       @relation("AssignedTechnician", fields: [technicianUserId], references: [id], onDelete: Restrict)

  @@index([jobId])
  @@index([technicianUserId, endedAt])
  @@map("job_assignments")
}

model Diagnosis {
  id               String   @id @default(uuid(7)) @db.Uuid
  jobId            String   @map("job_id") @db.Uuid
  technicianUserId String   @map("technician_user_id") @db.Uuid
  symptom          String   @db.VarChar(2000)
  findings         String   @db.VarChar(4000)
  rootCause        String?  @map("root_cause") @db.VarChar(2000)
  recommendation   String?  @db.VarChar(2000)
  /// Staff-only; never returned by customer endpoints.
  internalNotes    String?  @map("internal_notes") @db.VarChar(4000)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  job        ServiceJob @relation(fields: [jobId], references: [id], onDelete: Restrict)
  technician User       @relation(fields: [technicianUserId], references: [id], onDelete: Restrict)

  @@index([jobId, createdAt])
  @@map("diagnoses")
}

enum WorkLogVisibility {
  INTERNAL
  CUSTOMER

  @@map("work_log_visibility")
}

/// Work entries and notes. INTERNAL entries are staff-only notes; CUSTOMER
/// entries are customer-safe progress messages.
model WorkLog {
  id              String            @id @default(uuid(7)) @db.Uuid
  jobId           String            @map("job_id") @db.Uuid
  authorUserId    String            @map("author_user_id") @db.Uuid
  description     String            @db.VarChar(4000)
  durationMinutes Int?              @map("duration_minutes")
  visibility      WorkLogVisibility
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)

  job    ServiceJob @relation(fields: [jobId], references: [id], onDelete: Restrict)
  author User       @relation(fields: [authorUserId], references: [id], onDelete: Restrict)

  @@index([jobId, createdAt])
  @@map("work_logs")
}

// ---------------------------------------------------------------------------
// Notifications (outbox; providers mocked until Phase 10)
// ---------------------------------------------------------------------------

enum OutboxStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  DEAD
  SKIPPED

  @@map("outbox_status")
}

model NotificationOutbox {
  id             String       @id @default(uuid(7)) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  /// Branch of the related job, for branch-scoped listing.
  branchId       String?      @map("branch_id") @db.Uuid
  /// JOB_RECEIVED | JOB_STATUS_CHANGED | JOB_UPDATE_POSTED | REPAIR_COMPLETED | READY_FOR_DELIVERY
  eventType      String       @map("event_type") @db.VarChar(50)
  aggregateType  String       @map("aggregate_type") @db.VarChar(50)
  aggregateId    String       @map("aggregate_id") @db.Uuid
  customerId     String       @map("customer_id") @db.Uuid
  /// References and template parameters only — no free-text PII beyond what the template needs.
  payload        Json
  status         OutboxStatus @default(PENDING)
  attempts       Int          @default(0)
  nextAttemptAt  DateTime     @default(now()) @map("next_attempt_at") @db.Timestamptz(3)
  lockedUntil    DateTime?    @map("locked_until") @db.Timestamptz(3)
  lastError      String?      @map("last_error") @db.VarChar(200)
  idempotencyKey String       @unique @map("idempotency_key") @db.VarChar(150)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  deliveries NotificationDelivery[]

  @@index([status, nextAttemptAt])
  @@index([organizationId, createdAt(sort: Desc)])
  @@index([organizationId, branchId])
  @@index([aggregateType, aggregateId])
  @@map("notification_outbox")
}

enum NotificationChannel {
  WHATSAPP
  EMAIL

  @@map("notification_channel")
}

enum DeliveryStatus {
  /// Provider accepted the request — NOT proof of delivery (CLAUDE.md §11.15).
  ACCEPTED
  FAILED
  SKIPPED_NO_CONSENT
  SKIPPED_NO_ADDRESS
  /// Channel disabled or no approved template for the event (ADR 0018).
  SKIPPED_NOT_CONFIGURED
  /// Set only from provider delivery callbacks (Phase 10).
  DELIVERED
  READ

  @@map("delivery_status")
}

model NotificationDelivery {
  id                String              @id @default(uuid(7)) @db.Uuid
  outboxId          String              @map("outbox_id") @db.Uuid
  channel           NotificationChannel
  provider          String              @db.VarChar(50)
  templateName      String              @map("template_name") @db.VarChar(100)
  status            DeliveryStatus
  providerMessageId String?             @map("provider_message_id") @db.VarChar(200)
  errorCode         String?             @map("error_code") @db.VarChar(100)
  attempt           Int
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  deliveredAt       DateTime?           @map("delivered_at") @db.Timestamptz(3)
  readAt            DateTime?           @map("read_at") @db.Timestamptz(3)

  outbox NotificationOutbox @relation(fields: [outboxId], references: [id], onDelete: Restrict)

  @@unique([outboxId, channel, attempt])
  @@index([outboxId])
  @@map("notification_deliveries")
}

// ---------------------------------------------------------------------------
// Estimates (Phase 5, ADR 0014). Money: NUMERIC(19,4) (ADR 0005).
// ---------------------------------------------------------------------------

enum EstimateStatus {
  DRAFT
  SENT
  APPROVED
  REJECTED
  SUPERSEDED
  WITHDRAWN

  @@map("estimate_status")
}

enum EstimateLineType {
  LABOUR
  PART
  SERVICE_FEE
  OTHER

  @@map("estimate_line_type")
}

enum Coverage {
  CUSTOMER_PAY
  WARRANTY
  GOODWILL

  @@map("coverage")
}

/// Immutable once sent: a trigger allows only status/decision fields to change.
model Estimate {
  id              String         @id @default(uuid(7)) @db.Uuid
  organizationId  String         @map("organization_id") @db.Uuid
  branchId        String         @map("branch_id") @db.Uuid
  jobId           String         @map("job_id") @db.Uuid
  version         Int
  status          EstimateStatus @default(DRAFT)
  currency        String         @db.Char(3)
  subtotal        Decimal        @db.Decimal(19, 4)
  discountTotal   Decimal        @map("discount_total") @db.Decimal(19, 4)
  total           Decimal        @db.Decimal(19, 4)
  customerPayable Decimal        @map("customer_payable") @db.Decimal(19, 4)
  covered         Decimal        @db.Decimal(19, 4)
  /// NOT_CONFIGURED until approved tax configuration exists (Phase 7).
  taxTreatment    String         @default("NOT_CONFIGURED") @map("tax_treatment") @db.VarChar(30)
  validUntil      DateTime?      @map("valid_until") @db.Date
  /// Snapshot of the terms at send time.
  terms           String         @db.VarChar(4000)
  notes           String?        @db.VarChar(2000)
  preparedById    String         @map("prepared_by_id") @db.Uuid
  sentAt          DateTime?      @map("sent_at") @db.Timestamptz(3)
  sentById        String?        @map("sent_by_id") @db.Uuid
  decidedAt       DateTime?      @map("decided_at") @db.Timestamptz(3)
  rowVersion      Int            @default(1) @map("row_version")
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  job      ServiceJob             @relation(fields: [jobId], references: [id], onDelete: Restrict)
  lines    EstimateLine[]
  decision EstimateDecision?
  links    EstimateApprovalLink[]

  @@unique([jobId, version])
  @@index([organizationId, status])
  @@map("estimates")
}

model EstimateLine {
  id           String           @id @default(uuid(7)) @db.Uuid
  estimateId   String           @map("estimate_id") @db.Uuid
  position     Int
  lineType     EstimateLineType @map("line_type")
  description  String           @db.VarChar(500)
  /// Catalogue SKU snapshot (inventory arrives in Phase 6).
  sku          String?          @db.VarChar(60)
  quantity     Decimal          @db.Decimal(19, 4)
  unit         String           @db.VarChar(20)
  unitPrice    Decimal          @map("unit_price") @db.Decimal(19, 4)
  discount     Decimal          @db.Decimal(19, 4)
  coverage     Coverage
  lineTotal    Decimal          @map("line_total") @db.Decimal(19, 4)
  taxTreatment String           @default("NOT_CONFIGURED") @map("tax_treatment") @db.VarChar(30)

  estimate Estimate @relation(fields: [estimateId], references: [id], onDelete: Restrict)

  @@unique([estimateId, position])
  @@map("estimate_lines")
}

enum DecisionMethod {
  CUSTOMER_APP
  APPROVAL_LINK

  @@map("decision_method")
}

/// One decision per estimate; append-only.
model EstimateDecision {
  id              String         @id @default(uuid(7)) @db.Uuid
  estimateId      String         @unique @map("estimate_id") @db.Uuid
  decision        EstimateStatus
  method          DecisionMethod
  customerId      String         @map("customer_id") @db.Uuid
  estimateVersion Int            @map("estimate_version")
  /// Amount the customer approved/rejected (snapshot).
  customerPayable Decimal        @map("customer_payable") @db.Decimal(19, 4)
  termsAccepted   Boolean        @map("terms_accepted")
  /// SHA-256 of the terms text shown.
  termsHash       String         @map("terms_hash") @db.Char(64)
  comment         String?        @db.VarChar(1000)
  /// Stored only when AUDIT_STORE_CLIENT_METADATA=true.
  ipAddress       String?        @map("ip_address") @db.VarChar(45)
  userAgent       String?        @map("user_agent") @db.VarChar(500)
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  estimate Estimate @relation(fields: [estimateId], references: [id], onDelete: Restrict)

  @@map("estimate_decisions")
}

/// Secure, expiring, single-use approval links (token stored as SHA-256).
model EstimateApprovalLink {
  id          String    @id @default(uuid(7)) @db.Uuid
  estimateId  String    @map("estimate_id") @db.Uuid
  tokenHash   String    @unique @map("token_hash") @db.Char(64)
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt      DateTime? @map("used_at") @db.Timestamptz(3)
  revokedAt   DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdById String    @map("created_by_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  estimate Estimate @relation(fields: [estimateId], references: [id], onDelete: Restrict)

  @@index([estimateId])
  @@map("estimate_approval_links")
}

// ---------------------------------------------------------------------------
// Inventory (Phase 6, ADR 0015). Quantities and money: NUMERIC(19,4).
// ---------------------------------------------------------------------------

model Part {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  sku            String   @db.VarChar(60)
  name           String   @db.VarChar(200)
  description    String?  @db.VarChar(1000)
  category       String?  @db.VarChar(100)
  unit           String   @db.VarChar(20)
  reorderLevel   Decimal  @default(0) @map("reorder_level") @db.Decimal(19, 4)
  sellingPrice   Decimal? @map("selling_price") @db.Decimal(19, 4)
  /// Tax category placeholder — null until approved tax configuration (Phase 7).
  taxCategory    String?  @map("tax_category") @db.VarChar(50)
  isActive       Boolean  @default(true) @map("is_active")
  version        Int      @default(1)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  stock     BranchStock[]
  movements StockMovement[]
  jobParts  JobPart[]

  @@unique([organizationId, sku])
  @@unique([organizationId, id])
  @@map("parts")
}

model Supplier {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String   @db.VarChar(200)
  phone          String?  @db.VarChar(32)
  email          String?  @db.VarChar(254)
  notes          String?  @db.VarChar(1000)
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  movements StockMovement[]

  @@index([organizationId])
  @@map("suppliers")
}

model BranchStock {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  branchId       String   @map("branch_id") @db.Uuid
  partId         String   @map("part_id") @db.Uuid
  onHand         Decimal  @default(0) @map("on_hand") @db.Decimal(19, 4)
  reserved       Decimal  @default(0) @db.Decimal(19, 4)
  /// Branch-specific override of the part's reorder level.
  reorderLevel   Decimal? @map("reorder_level") @db.Decimal(19, 4)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  part Part @relation(fields: [organizationId, partId], references: [organizationId, id], onDelete: Restrict)

  @@unique([branchId, partId])
  @@index([organizationId, partId])
  @@map("branch_stock")
}

enum StockMovementType {
  RECEIVE
  ADJUST
  TRANSFER_OUT
  TRANSFER_IN
  RESERVE
  RELEASE
  CONSUME
  RETURN

  @@map("stock_movement_type")
}

/// Append-only stock ledger. branch_stock must equal the sum of these deltas.
model StockMovement {
  id               String            @id @default(uuid(7)) @db.Uuid
  organizationId   String            @map("organization_id") @db.Uuid
  branchId         String            @map("branch_id") @db.Uuid
  partId           String            @map("part_id") @db.Uuid
  type             StockMovementType
  onHandDelta      Decimal           @map("on_hand_delta") @db.Decimal(19, 4)
  reservedDelta    Decimal           @map("reserved_delta") @db.Decimal(19, 4)
  unitCost         Decimal?          @map("unit_cost") @db.Decimal(19, 4)
  supplierId       String?           @map("supplier_id") @db.Uuid
  jobId            String?           @map("job_id") @db.Uuid
  /// Pairs TRANSFER_OUT/TRANSFER_IN movements.
  transferId       String?           @map("transfer_id") @db.Uuid
  reference        String?           @db.VarChar(100)
  reason           String?           @db.VarChar(500)
  negativeOverride Boolean           @default(false) @map("negative_override")
  actorUserId      String            @map("actor_user_id") @db.Uuid
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)

  part     Part      @relation(fields: [organizationId, partId], references: [organizationId, id], onDelete: Restrict)
  supplier Supplier? @relation(fields: [supplierId], references: [id], onDelete: Restrict)

  @@index([branchId, partId, createdAt])
  @@index([jobId])
  @@map("stock_movements")
}

enum RemovedPartDisposition {
  RETURNED_TO_CUSTOMER
  SENT_TO_VENDOR
  SCRAPPED
  KEPT_FOR_WARRANTY_CLAIM

  @@map("removed_part_disposition")
}

/// Parts used on a job (quantities kept in step with stock movements).
model JobPart {
  id                     String                  @id @default(uuid(7)) @db.Uuid
  jobId                  String                  @map("job_id") @db.Uuid
  organizationId         String                  @map("organization_id") @db.Uuid
  branchId               String                  @map("branch_id") @db.Uuid
  partId                 String                  @map("part_id") @db.Uuid
  reserved               Decimal                 @default(0) @db.Decimal(19, 4)
  consumed               Decimal                 @default(0) @db.Decimal(19, 4)
  returned               Decimal                 @default(0) @db.Decimal(19, 4)
  removedPartDescription String?                 @map("removed_part_description") @db.VarChar(300)
  removedPartSerial      String?                 @map("removed_part_serial") @db.VarChar(100)
  disposition            RemovedPartDisposition?
  createdAt              DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime                @updatedAt @map("updated_at") @db.Timestamptz(3)

  job  ServiceJob @relation(fields: [jobId], references: [id], onDelete: Restrict)
  part Part       @relation(fields: [organizationId, partId], references: [organizationId, id], onDelete: Restrict)

  @@unique([jobId, partId])
  @@map("job_parts")
}

// ---------------------------------------------------------------------------
// Payments (Phase 8, ADR 0016). Money: NUMERIC(19,4).
// ---------------------------------------------------------------------------

enum PaymentMethod {
  CASH
  UPI
  BANK_TRANSFER
  CARD_TERMINAL
  CHEQUE
  OTHER

  @@map("payment_method")
}

enum PaymentStatus {
  RECORDED
  REVERSED

  @@map("payment_status")
}

/// Money received. Core fields immutable (trigger); never deleted.
model Payment {
  id             String        @id @default(uuid(7)) @db.Uuid
  organizationId String        @map("organization_id") @db.Uuid
  branchId       String        @map("branch_id") @db.Uuid
  receiptNumber  String        @map("receipt_number") @db.VarChar(40)
  customerId     String        @map("customer_id") @db.Uuid
  jobId          String?       @map("job_id") @db.Uuid
  currency       String        @db.Char(3)
  amount         Decimal       @db.Decimal(19, 4)
  method         PaymentMethod
  /// UTR / cheque / slip number — never card numbers or secrets.
  reference      String?       @db.VarChar(100)
  receivedAt     DateTime      @map("received_at") @db.Timestamptz(3)
  receivedById   String        @map("received_by_id") @db.Uuid
  notes          String?       @db.VarChar(500)
  status         PaymentStatus @default(RECORDED)
  /// Maintained by invoice allocation (Phase 7); 0 until then.
  allocatedTotal Decimal       @default(0) @map("allocated_total") @db.Decimal(19, 4)
  refundedTotal  Decimal       @default(0) @map("refunded_total") @db.Decimal(19, 4)
  reversedAt     DateTime?     @map("reversed_at") @db.Timestamptz(3)
  reversedById   String?       @map("reversed_by_id") @db.Uuid
  reversalReason String?       @map("reversal_reason") @db.VarChar(500)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  refunds     PaymentRefund[]
  allocations PaymentAllocation[]

  @@unique([organizationId, receiptNumber])
  @@index([organizationId, customerId])
  @@index([jobId])
  @@index([organizationId, branchId, receivedAt])
  @@map("payments")
}

/// Append-only refunds of on-account money.
model PaymentRefund {
  id             String        @id @default(uuid(7)) @db.Uuid
  organizationId String        @map("organization_id") @db.Uuid
  branchId       String        @map("branch_id") @db.Uuid
  paymentId      String        @map("payment_id") @db.Uuid
  refundNumber   String        @map("refund_number") @db.VarChar(40)
  amount         Decimal       @db.Decimal(19, 4)
  method         PaymentMethod
  reference      String?       @db.VarChar(100)
  reason         String        @db.VarChar(500)
  approvedById   String        @map("approved_by_id") @db.Uuid
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@unique([organizationId, refundNumber])
  @@index([paymentId])
  @@index([organizationId, branchId, createdAt])
  @@map("payment_refunds")
}

// ---------------------------------------------------------------------------
// Delivery (Phase 9, ADR 0017)
// ---------------------------------------------------------------------------

enum DeliveryMode {
  CUSTOMER_PICKUP
  HOME_DELIVERY
  ON_SITE_RETURN
  OTHER

  @@map("delivery_mode")
}

enum DeliveryStatus2 {
  DISPATCHED
  COMPLETED
  FAILED

  @@map("delivery_record_status")
}

enum RecipientRelationship {
  SELF
  AUTHORIZED_PERSON
  FAMILY
  COLLEAGUE
  OTHER

  @@map("recipient_relationship")
}

enum ProofMethod {
  SIGNED_CHALLAN
  PHOTO_PROOF

  @@map("proof_method")
}

model Delivery {
  id                String                 @id @default(uuid(7)) @db.Uuid
  organizationId    String                 @map("organization_id") @db.Uuid
  branchId          String                 @map("branch_id") @db.Uuid
  jobId             String                 @map("job_id") @db.Uuid
  challanNumber     String                 @map("challan_number") @db.VarChar(40)
  mode              DeliveryMode
  status            DeliveryStatus2
  /// Address snapshot for home delivery / on-site return.
  address           Json?
  dispatchedAt      DateTime?              @map("dispatched_at") @db.Timestamptz(3)
  dispatchedById    String?                @map("dispatched_by_id") @db.Uuid
  recipientName     String?                @map("recipient_name") @db.VarChar(200)
  relationship      RecipientRelationship?
  authorizationNote String?                @map("authorization_note") @db.VarChar(500)
  checklist         Json?
  conditionNotes    String?                @map("condition_notes") @db.VarChar(1000)
  proofMethod       ProofMethod?           @map("proof_method")
  proofFileId       String?                @map("proof_file_id") @db.Uuid
  /// Balance snapshot at hand-over (interim basis until invoicing).
  balanceSnapshot   Json?                  @map("balance_snapshot")
  dueOverrideReason String?                @map("due_override_reason") @db.VarChar(500)
  dueOverrideById   String?                @map("due_override_by_id") @db.Uuid
  deliveredAt       DateTime?              @map("delivered_at") @db.Timestamptz(3)
  deliveredById     String?                @map("delivered_by_id") @db.Uuid
  failedReason      String?                @map("failed_reason") @db.VarChar(500)
  createdAt         DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)

  job   ServiceJob     @relation(fields: [jobId], references: [id], onDelete: Restrict)
  items DeliveryItem[]

  @@unique([organizationId, challanNumber])
  @@index([jobId])
  @@index([organizationId, branchId, deliveredAt])
  @@map("deliveries")
}

model DeliveryItem {
  id          String   @id @default(uuid(7)) @db.Uuid
  deliveryId  String   @map("delivery_id") @db.Uuid
  description String   @db.VarChar(200)
  returned    Boolean
  condition   String?  @db.VarChar(300)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  delivery Delivery @relation(fields: [deliveryId], references: [id], onDelete: Restrict)

  @@index([deliveryId])
  @@map("delivery_items")
}

// ---------------------------------------------------------------------------
// Multi-factor authentication (Phase 11, ADR 0011)

/// TOTP secret for a staff user. Enabled once the first code is confirmed.
model UserMfa {
  userId       String    @id @map("user_id") @db.Uuid
  /// AES-256-GCM sealed secret (key from MFA_ENCRYPTION_KEY); never returned after enrolment.
  secretSealed String    @map("secret_sealed") @db.VarChar(200)
  enabledAt    DateTime? @map("enabled_at") @db.Timestamptz(3)
  /// Last accepted TOTP time step: a code is accepted at most once (replay protection).
  lastUsedStep BigInt?   @map("last_used_step")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@map("user_mfa")
}

/// Single-use recovery codes, stored as Argon2id hashes.
model UserMfaRecoveryCode {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  codeHash  String    @map("code_hash") @db.VarChar(255)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@map("user_mfa_recovery_codes")
}

/// Pending second sign-in step (password verified, code not yet).
model MfaChallenge {
  id         String    @id @default(uuid(7)) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  /// SHA-256 of the opaque challenge token.
  tokenHash  String    @unique @map("token_hash") @db.Char(64)
  attempts   Int       @default(0)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@map("mfa_challenges")
}

// ---------------------------------------------------------------------------
// GST invoicing (Phase 7, ADR 0021/0022). Money NUMERIC(19,4); invoice values are
// computed to paise. Issued invoices, credit notes and summaries are frozen by triggers.

enum InvoiceStatus {
  DRAFT
  ISSUED
  CANCELLED

  @@map("invoice_status")
}

enum SupplyType {
  INTRA_STATE
  INTER_STATE

  @@map("supply_type")
}

model Invoice {
  id                String        @id @default(uuid(7)) @db.Uuid
  organizationId    String        @map("organization_id") @db.Uuid
  branchId          String        @map("branch_id") @db.Uuid
  jobId             String        @map("job_id") @db.Uuid
  customerId        String        @map("customer_id") @db.Uuid
  sourceEstimateId  String?       @map("source_estimate_id") @db.Uuid
  status            InvoiceStatus @default(DRAFT)
  /// Assigned at issue: unique per organisation, ≤ 16 characters (GST).
  invoiceNumber     String?       @map("invoice_number") @db.VarChar(16)
  financialYear     String?       @map("financial_year") @db.VarChar(9)
  invoiceDate       DateTime?     @map("invoice_date") @db.Date
  currency          String        @db.Char(3)
  supplyType        SupplyType    @map("supply_type")
  placeOfSupplyCode String        @map("place_of_supply_code") @db.Char(2)
  reverseCharge     Boolean       @default(false) @map("reverse_charge")
  /// Immutable snapshots taken at issue (supplier) / kept current while draft (recipient).
  supplier          Json?
  recipient         Json
  taxableTotal      Decimal       @default(0) @map("taxable_total") @db.Decimal(19, 4)
  cgstTotal         Decimal       @default(0) @map("cgst_total") @db.Decimal(19, 4)
  sgstTotal         Decimal       @default(0) @map("sgst_total") @db.Decimal(19, 4)
  igstTotal         Decimal       @default(0) @map("igst_total") @db.Decimal(19, 4)
  taxTotal          Decimal       @default(0) @map("tax_total") @db.Decimal(19, 4)
  roundOff          Decimal       @default(0) @map("round_off") @db.Decimal(19, 4)
  total             Decimal       @default(0) @db.Decimal(19, 4)
  creditedTotal     Decimal       @default(0) @map("credited_total") @db.Decimal(19, 4)
  allocatedTotal    Decimal       @default(0) @map("allocated_total") @db.Decimal(19, 4)
  notes             String?       @db.VarChar(1000)
  terms             String?       @db.VarChar(2000)
  rowVersion        Int           @default(1) @map("row_version")
  createdById       String        @map("created_by_id") @db.Uuid
  issuedAt          DateTime?     @map("issued_at") @db.Timestamptz(3)
  issuedById        String?       @map("issued_by_id") @db.Uuid
  cancelledAt       DateTime?     @map("cancelled_at") @db.Timestamptz(3)
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  job          ServiceJob          @relation(fields: [jobId], references: [id], onDelete: Restrict)
  lines        InvoiceLine[]
  taxSummaries InvoiceTaxSummary[]
  creditNotes  CreditNote[]
  allocations  PaymentAllocation[]

  @@unique([organizationId, invoiceNumber])
  @@index([jobId])
  @@index([organizationId, branchId, invoiceDate])
  @@index([organizationId, customerId])
  @@map("invoices")
}

model InvoiceLine {
  id                   String           @id @default(uuid(7)) @db.Uuid
  invoiceId            String           @map("invoice_id") @db.Uuid
  position             Int
  lineType             EstimateLineType @map("line_type")
  description          String           @db.VarChar(500)
  hsnSac               String           @map("hsn_sac") @db.VarChar(8)
  quantity             Decimal          @db.Decimal(19, 4)
  unit                 String           @db.VarChar(20)
  unitPrice            Decimal          @map("unit_price") @db.Decimal(19, 4)
  discount             Decimal          @db.Decimal(19, 4)
  taxableValue         Decimal          @map("taxable_value") @db.Decimal(19, 4)
  taxCategory          String           @map("tax_category") @db.VarChar(30)
  gstRate              Decimal          @map("gst_rate") @db.Decimal(6, 3)
  cgstRate             Decimal          @map("cgst_rate") @db.Decimal(6, 3)
  sgstRate             Decimal          @map("sgst_rate") @db.Decimal(6, 3)
  igstRate             Decimal          @map("igst_rate") @db.Decimal(6, 3)
  cgstAmount           Decimal          @map("cgst_amount") @db.Decimal(19, 4)
  sgstAmount           Decimal          @map("sgst_amount") @db.Decimal(19, 4)
  igstAmount           Decimal          @map("igst_amount") @db.Decimal(19, 4)
  lineTotal            Decimal          @map("line_total") @db.Decimal(19, 4)
  creditedQuantity     Decimal          @default(0) @map("credited_quantity") @db.Decimal(19, 4)
  sourceEstimateLineId String?          @map("source_estimate_line_id") @db.Uuid

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  @@unique([invoiceId, position])
  @@map("invoice_lines")
}

/// HSN/SAC × rate summary written once at issue.
model InvoiceTaxSummary {
  id           String  @id @default(uuid(7)) @db.Uuid
  invoiceId    String  @map("invoice_id") @db.Uuid
  hsnSac       String  @map("hsn_sac") @db.VarChar(8)
  gstRate      Decimal @map("gst_rate") @db.Decimal(6, 3)
  taxableValue Decimal @map("taxable_value") @db.Decimal(19, 4)
  cgstAmount   Decimal @map("cgst_amount") @db.Decimal(19, 4)
  sgstAmount   Decimal @map("sgst_amount") @db.Decimal(19, 4)
  igstAmount   Decimal @map("igst_amount") @db.Decimal(19, 4)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  @@unique([invoiceId, hsnSac, gstRate])
  @@map("invoice_tax_summaries")
}

/// Corrections to issued invoices (never edits). Append-only.
model CreditNote {
  id               String   @id @default(uuid(7)) @db.Uuid
  organizationId   String   @map("organization_id") @db.Uuid
  branchId         String   @map("branch_id") @db.Uuid
  invoiceId        String   @map("invoice_id") @db.Uuid
  creditNoteNumber String   @map("credit_note_number") @db.VarChar(16)
  financialYear    String   @map("financial_year") @db.VarChar(9)
  noteDate         DateTime @map("note_date") @db.Date
  reason           String   @db.VarChar(500)
  isFull           Boolean  @map("is_full")
  taxableTotal     Decimal  @map("taxable_total") @db.Decimal(19, 4)
  cgstTotal        Decimal  @map("cgst_total") @db.Decimal(19, 4)
  sgstTotal        Decimal  @map("sgst_total") @db.Decimal(19, 4)
  igstTotal        Decimal  @map("igst_total") @db.Decimal(19, 4)
  roundOff         Decimal  @map("round_off") @db.Decimal(19, 4)
  total            Decimal  @db.Decimal(19, 4)
  snapshot         Json
  createdById      String   @map("created_by_id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  invoice Invoice          @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  lines   CreditNoteLine[]

  @@unique([organizationId, creditNoteNumber])
  @@index([invoiceId])
  @@index([organizationId, noteDate])
  @@map("credit_notes")
}

model CreditNoteLine {
  id            String  @id @default(uuid(7)) @db.Uuid
  creditNoteId  String  @map("credit_note_id") @db.Uuid
  invoiceLineId String  @map("invoice_line_id") @db.Uuid
  quantity      Decimal @db.Decimal(19, 4)
  taxableValue  Decimal @map("taxable_value") @db.Decimal(19, 4)
  cgstAmount    Decimal @map("cgst_amount") @db.Decimal(19, 4)
  sgstAmount    Decimal @map("sgst_amount") @db.Decimal(19, 4)
  igstAmount    Decimal @map("igst_amount") @db.Decimal(19, 4)
  lineTotal     Decimal @map("line_total") @db.Decimal(19, 4)

  creditNote CreditNote @relation(fields: [creditNoteId], references: [id], onDelete: Restrict)

  @@index([creditNoteId])
  @@map("credit_note_lines")
}

/// Payment ↔ invoice allocation. Released (never deleted) when an allocation must be undone.
model PaymentAllocation {
  id             String    @id @default(uuid(7)) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  paymentId      String    @map("payment_id") @db.Uuid
  invoiceId      String    @map("invoice_id") @db.Uuid
  amount         Decimal   @db.Decimal(19, 4)
  createdById    String    @map("created_by_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  releasedAt     DateTime? @map("released_at") @db.Timestamptz(3)
  releasedById   String?   @map("released_by_id") @db.Uuid
  releaseReason  String?   @map("release_reason") @db.VarChar(500)

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  @@index([paymentId])
  @@index([invoiceId])
  @@map("payment_allocations")
}
